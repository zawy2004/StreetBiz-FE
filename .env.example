VITE_APP_ENV=development
VITE_ENABLE_PAYMENT_SANDBOX=true
VITE_API_BASE_URL=https://localhost:7147/api
VITE_USE_MOCK_API=false
VITE_ENABLE_AI_COMPLIANCE=true
VITE_ENABLE_PHASE_2=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
# Free key from https://carto.com/basemaps/apikey/ -- optional, the slot map
# falls back to Esri's street tiles when this is empty.
VITE_CARTO_API_KEY=
