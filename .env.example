VITE_APP_ENV=development

# StreetBiz-BE base URL. The API listens on http://localhost:5000 (see
# StreetBiz-BE/src/StreetBiz.API/Properties/launchSettings.json).
VITE_API_BASE_URL=http://localhost:5000/api

# true  -> Authentication and Vendor Onboarding use src/mocks (no backend needed)
# false -> they call StreetBiz-BE
VITE_USE_MOCK_API=false

VITE_ENABLE_AI_COMPLIANCE=true
VITE_ENABLE_PHASE_2=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_PAYMENT_SANDBOX=true
