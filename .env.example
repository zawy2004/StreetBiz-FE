VITE_APP_ENV=development
VITE_ENABLE_PAYMENT_SANDBOX=true

# StreetBiz-BE base URL. The API's launch profiles are https://localhost:7147
# and http://localhost:5023 (StreetBiz-BE/src/StreetBiz.API/Properties/launchSettings.json).
# Use the http one if the ASP.NET dev certificate is not trusted on your machine.
VITE_API_BASE_URL=https://localhost:7147/api

# true  -> Authentication and Vendor Onboarding use src/mocks (no backend needed)
# false -> they call StreetBiz-BE
VITE_USE_MOCK_API=false

VITE_ENABLE_AI_COMPLIANCE=true
VITE_ENABLE_PHASE_2=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
# Free key from https://carto.com/basemaps/apikey/ -- optional, the slot map
# falls back to Esri's street tiles when this is empty.
VITE_CARTO_API_KEY=
