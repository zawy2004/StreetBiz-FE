VITE_APP_ENV=development
VITE_API_BASE_URL=https://localhost:7147/api
VITE_USE_MOCK_API=false
VITE_ENABLE_AI_COMPLIANCE=true
VITE_ENABLE_PHASE_2=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
# Maptiles key from https://account.goong.io -- optional, the vendor slot map and
# location picker fall back to Esri's keyless raster tiles when this is empty.
VITE_GOONG_MAPTILES_KEY=
# Free key from https://carto.com/basemaps/apikey/ -- optional, the ward slot grid map
# (still on Leaflet) falls back to Esri's street tiles when this is empty.
VITE_CARTO_API_KEY=
