{
  "expo": {
    "name": "StreetBiz",
    "slug": "streetbiz",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "streetbiz",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.streetbiz"
    },
    "android": {
      "package": "com.example.streetbiz"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
